---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { getPage } from '../lib/content';
import { url } from '../lib/site';

const page = await getPage('contact');
const { title, summary, email, linkedin, github, resumePdf, location } = page.data;
const { Content } = await render(page);
---
<Base title={title} description={summary}>
  <PageHeader title={title} lede={summary} />
  <section class="section">
    <div class="wrap contact-layout">
      <div class="prose">
        <Content />
        <div class="actions" style="margin-top: 28px">
          {email && <a class="btn" href={`mailto:${email}`}><Icon name="mail" /> Get in touch</a>}
          {resumePdf && <a class="btn btn--outline" href={url(resumePdf)} download><Icon name="download" /> Download resume</a>}
        </div>
      </div>
      <aside class="contact-card" aria-label="Contact details">
        <dl>
          {email && (
            <div>
              <dt><Icon name="mail" /> Email</dt>
              <dd class="email-row">
                <a href={`mailto:${email}`}>{email}</a>
                <button type="button" class="copy-btn" data-copy={email} hidden>Copy</button>
              </dd>
            </div>
          )}
          {linkedin && (<div><dt><Icon name="linkedin" /> LinkedIn</dt><dd><a href={linkedin} rel="noopener">james-spooner1995</a></dd></div>)}
          {github && (<div><dt><Icon name="github" /> GitHub</dt><dd><a href={github} rel="noopener">James1-9-9-5</a></dd></div>)}
          {location && (<div><dt><Icon name="pin" /> Location</dt><dd>{location}</dd></div>)}
          {resumePdf && (<div><dt><Icon name="download" /> Resume</dt><dd><a href={url(resumePdf)} download>Download (PDF)</a></dd></div>)}
        </dl>
      </aside>
    </div>
  </section>
  <script>
    // "Copy" button for people without a mail app; hidden if the browser can't copy
    document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
      if (!navigator.clipboard) return;
      btn.hidden = false;
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? '');
          btn.textContent = 'Copied';
          btn.classList.add('is-copied');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('is-copied'); }, 2000);
        } catch { /* leave the button as it was */ }
      });
    });
  </script>
</Base>
