---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getPage, getProjects } from '../../lib/content';

const page = await getPage('projects');
const projects = await getProjects();
---
<Base title={page.data.title} description={page.data.summary}>
  <PageHeader title={page.data.title} lede={page.data.summary} />
  <section class="section">
    <div class="wrap">
      <ul class="grid">
        {projects.map((project) => <li><ProjectCard project={project} headingLevel="h2" /></li>)}
      </ul>
      <p class="note">
        Much of my work is confidential or under NDA, so these case studies leave out client and community details.
        I'm happy to talk through any of them in more depth.
      </p>
    </div>
  </section>
</Base>
