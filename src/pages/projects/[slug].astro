---
import { Image, getImage } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import { getProjects, getSkillNames } from '../../lib/content';
import { slugify, url } from '../../lib/site';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length], related: projects.filter((p) => p.id !== project.id) },
  }));
}

const { project, next, related } = Astro.props;
const d = project.data;

// Rule (docs/02): role must match an Experience file. Fail the build if not.
const role = await getEntry(d.role);
if (!role) throw new Error(`Project "${project.id}": role "${d.role.id}" has no file in content/experience/`);

// Rule (docs/02): tools should match skills.yaml. Warning only.
const skillNames = await getSkillNames();
for (const tool of d.tools) {
  if (!skillNames.has(tool)) console.warn(`[content] Project "${project.id}": tool "${tool}" is not in content/data/skills.yaml`);
}

const { Content } = await render(project);

// Share preview: this project's cover, cropped to 1200 x 630
const share = await getImage({ src: d.cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
---
<Base title={d.title} description={d.summary} image={share.src} imageAlt={d.coverAlt}>
  <PageHeader title={d.title} lede={d.subtitle}>
    <p class="eyebrow" slot="eyebrow"><a href={url('projects/')}>Projects</a></p>
  </PageHeader>

  <div class="wrap case-banner">
    <Image src={d.cover} alt={d.coverAlt} width={Math.min(1600, d.cover.width)} widths={[800, 1200, 1600].filter((w) => w <= d.cover.width)} sizes="(max-width: 1100px) 100vw, 1040px" loading="eager" fetchpriority="high" />
  </div>

  <section class="section section--case">
    <div class="wrap case-layout">

      <div class="case-body prose">
        <Content />
        {d.clearance === 'redacted' && (
          <p class="note">Client and community details have been left out or generalized.</p>
        )}
        {related.length > 0 && (
          <section class="related" aria-labelledby="related-title">
            <h2 id="related-title">Related</h2>
            <ul class="related-list">
              {related.map((r) => (
                <li>
                  <a href={url(`projects/${r.id}/`)}>
                    <span class="related-kind">Project</span>
                    <strong>{r.data.title}</strong>
                    <span>{r.data.subtitle}</span>
                  </a>
                </li>
              ))}
              <li>
                <a href={url('projects/#how-title')}>
                  <span class="related-kind">Approach</span>
                  <strong>How I approach a project</strong>
                  <span>The four steps I follow when building systems with a community</span>
                </a>
              </li>
            </ul>
          </section>
        )}
        <nav class="case-nav" aria-label="More projects">
          <a class="back-link" href={url('projects/')}><Icon name="back" size={16} /> All projects</a>
          {next.id !== project.id && (
            <a class="next-link" href={url(`projects/${next.id}/`)}>
              <span>Next project</span>
              <strong>{next.data.title} <Icon name="arrow" size={16} /></strong>
            </a>
          )}
        </nav>
      </div>

      <aside class="case-aside" aria-label="Project details">
        <div>
          <h2>Tools</h2>
          <ul class="chips">
            {d.tools.map((tool) => (
              <li>
                {skillNames.has(tool)
                  ? <a class="chip" href={url(`skills-education/#${slugify(tool)}`)}>{tool}</a>
                  : <span class="chip">{tool}</span>}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2>Role</h2>
          <p style="margin: 0">
            <a href={url(`experience/#${role.id}`)}>{role.data.role}{role.data.organization && `, ${role.data.organization}`}</a>
          </p>
        </div>
      </aside>
    </div>
  </section>
</Base>
