---
// Small inline icons (replaces the Font Awesome CDN from the old site).
// Decorative by default: pair them with visible text or an aria-label.
interface Props {
  name: 'mail' | 'download' | 'linkedin' | 'github' | 'pin' | 'arrow' | 'back';
  size?: number;
}
const { name, size = 18 } = Astro.props;
---
<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === 'mail' && (<><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6.5 8.5 6.5 8.5-6.5" /></>)}
  {name === 'download' && (<><path d="M12 4v11" /><path d="m7 10 5 5 5-5" /><path d="M5 20h14" /></>)}
  {name === 'linkedin' && (<><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M8 10.5V17" /><path d="M8 7.3v.2" /><path d="M12 17v-6.5" /><path d="M12 13.5c0-1.8 1.2-3 2.6-3S17 11.4 17 13v4" /></>)}
  {name === 'github' && (<><path d="m8 8-4 4 4 4" /><path d="m16 8 4 4-4 4" /><path d="m13.5 5-3 14" /></>)}
  {name === 'pin' && (<><path d="M12 21s-6-5.6-6-11a6 6 0 0 1 12 0c0 5.4-6 11-6 11z" /><circle cx="12" cy="10" r="2.2" /></>)}
  {name === 'arrow' && (<><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></>)}
  {name === 'back' && (<><path d="M19 12H5" /><path d="m11 6-6 6 6 6" /></>)}
</svg>
