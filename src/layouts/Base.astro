---
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/600.css';
import '@fontsource/source-sans-3/700.css';
import '@fontsource/bricolage-grotesque/600.css';
import '@fontsource/bricolage-grotesque/700.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { getEntry } from 'astro:content';
import { NAV, isCurrent, url } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD for this page (e.g. Person on Home) */
  jsonLd?: Record<string, unknown>;
  /** Share-preview image for this page (path or URL); defaults to the site card */
  image?: string;
  imageAlt?: string;
}
const { title, description, jsonLd, image, imageAlt } = Astro.props;

const contact = await getEntry('pages', 'contact');
if (!contact) throw new Error('content/pages/contact.md is missing');
const { email, linkedin, github, resumePdf } = contact.data;

const fullTitle = title.includes('James Spooner') ? title : `${title} | James Spooner`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image ?? url('og-image.jpg'), Astro.site).href;
const ogImageAlt = imageAlt ?? 'James Spooner, GIS Specialist: asset management, field data and maintenance systems with First Nations communities.';
const now = new Date();
const year = now.getFullYear();
const ICON_VERSION = 3;
const updated = now.toLocaleDateString('en-CA', { month: 'long', year: 'numeric', timeZone: 'America/Vancouver' });
const links = NAV.map((item) => ({
  label: item.label,
  href: url(item.path ? `${item.path}/` : ''),
  current: isCurrent(item.path, Astro.url.pathname),
}));
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:site_name" content="James Spooner" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#2b2b2b" />
    <!-- ?v= forces browsers to fetch new icons; bump it whenever the icons change -->
    <link rel="icon" href={url(`favicon.ico?v=${ICON_VERSION}`)} sizes="any" />
    <link rel="icon" href={url(`favicon.svg?v=${ICON_VERSION}`)} type="image/svg+xml" />
    <link rel="manifest" href={url(`site.webmanifest?v=${ICON_VERSION}`)} />
    <link rel="icon" type="image/png" sizes="32x32" href={url(`favicon-32x32.png?v=${ICON_VERSION}`)} />
    <link rel="apple-touch-icon" sizes="180x180" href={url(`apple-touch-icon.png?v=${ICON_VERSION}`)} />
    <link rel="sitemap" href={url('sitemap.xml')} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <nav class="site-nav" aria-label="Main">
      <!-- Desktop: centred tabs -->
      <ul class="nav-links">
        {links.map((item) => (
          <li><a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
      <!-- Phones: name + Menu button (a <details>, so it works without JavaScript) -->
      <div class="nav-mobile">
        <a class="nav-brand" href={url('')}>James Spooner</a>
        <details class="nav-menu">
          <summary><span class="nav-menu-icon" aria-hidden="true"></span>Menu</summary>
          <ul>
            {links.map((item) => (
              <li><a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </details>
      </div>
    </nav>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer on-dark">
      <div class="wrap">
        <ul class="footer-links">
          {email && <li><a href={`mailto:${email}`}><Icon name="mail" /> Email</a></li>}
          {linkedin && <li><a href={linkedin} rel="noopener"><Icon name="linkedin" /> LinkedIn</a></li>}
          {github && <li><a href={github} rel="noopener"><Icon name="github" /> GitHub</a></li>}
          {resumePdf && <li><a href={url(resumePdf)} download><Icon name="download" /> Resume</a></li>}
        </ul>
        <small>&copy; {year} James Spooner · Vancouver, BC · Last updated {updated}</small>
      </div>
    </footer>
  </body>
</html>
